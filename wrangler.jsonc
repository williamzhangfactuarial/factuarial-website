{
  "name": "factuarial-website",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SITE_ORIGIN": "https://factuarial.insure"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "contact@factuarial.insure"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "factuarial.insure",
      "custom_domain": true
    }
  ]
}
